# Nusxa oling: cp .env.example .env
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*

# Bo'sh bo'lsa SQLite (db.sqlite3) ishlatiladi
# DATABASE_URL=postgres://shgat:shgat@localhost:5432/shgat

MEDIA_ROOT=./media

# Ochiq ArcGIS test qatlami (4.3-bo'lim)
ARCGIS_LAYER_URL=https://sampleserver6.arcgisonline.com/arcgis/rest/services/Wildfire/FeatureServer/2
ARCGIS_TIMEOUT=15
ARCGIS_RETRIES=2

# Boshqa SOATO ro'yxatini ulash (ixtiyoriy)
# SOATO_FILE=/path/to/soato.json
LOG_LEVEL=INFO
